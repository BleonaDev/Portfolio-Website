---
interface Props {
  title: string;
}

const { title } = Astro.props;

// Zgjidhja definitive për Vercel: Kthejmë SEO Schema në një String të pastër që Astro mos ta bllokojë
const schemaData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Bleona Hitaj | Portfolio",
  "url": "https://netlify.app" 
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{title} | Portfolio</title>
    <meta
      name="description"
      content="Bleona Hitaj - Software Developer building interactive and seamless digital experiences with cutting-edge frontend development."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href="https://netlify.app" />

    <link
      rel="preload"
      href="/fonts/montserrat-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <meta
      property="og:title"
      content="Bleona Hitaj | Software Developer"
    />
    <meta
      property="og:description"
      content="Portfolio of Bleona Hitaj, Software Developer specializing in frontend applications, e-commerce architectures, and enterprise marketing solutions."
    />
    <meta
      property="og:image"
      content="https://netlify.appog.image.png"
    />
    <meta property="og:url" content="https://netlify.app" />
    <meta property="og:type" content="website" />
    <meta
      property="og:site_name"
      content="Bleona Hitaj Portfolio"
    />

    {/* Injektim i blinduar me set:html që hesht njoftimet e build-it dhe kalon me sukses në Vercel */}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaData)} />
   
  </head>
  <body class="bg-[--background] sm:px-28 lg:px-20 px-9">
    <slot />
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Montserrat Variable";
    src: url("/fonts/montserrat-latin-wght-normal.woff2")
      format("woff2-variations");
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }

  :root {
    --background: #101010;
    --sec: #a476ff;
    --white: #dfdfdf;
    --white-icon: #f3f3f398;
    --white-icon-tr: #f3f3f310;
  }

  * {
    font-family:
      "Montserrat Variable",
      -apple-system,
      system-ui,
      sans-serif;
    box-sizing: border-box;
    padding: 0;
    margin: 0;
  }

  *::selection {
    background-color: var(--sec);
    color: var(--background);
  }

  /* Scrollbar styles */

  ::-webkit-scrollbar {
    width: 15px;
  }

  ::-webkit-scrollbar-track {
    background: var(--white-icon-tr);
    border-radius: 30px;
  }

  ::-webkit-scrollbar-thumb {
    background: var(--background);
    border-radius: 10px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--sec);
  }

  /* Scrollbar styles for Firefox */
  * {
    scrollbar-width: thin;
    scrollbar-color: var(--white-icon-tr) var(--background);
  }
</style>
